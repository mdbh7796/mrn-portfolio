PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mrn_portfolio
CLIENT_URL=http://localhost:5173

# Contact email notifications (Gmail SMTP). Optional: when unset, messages are
# only saved to MongoDB. Set these in Vercel > Settings > Environment Variables too.
# GMAIL_APP_PASSWORD is a Google App Password (Account > Security > 2-Step
# Verification > App passwords), NOT your login password.
CONTACT_TO=you@example.com
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
